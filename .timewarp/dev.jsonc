{
  // Per-repo configuration for TimeWarp.Flexbox dev-cli
  "checkVersionConfig": {
    "checkVersionStrategy": "nuget-search",
    "packages": "TimeWarp.Flexbox"
  },
  // Additions to PullRequestBuildClassifier (dev workflow on a pull request).
  // readme.md and assets/logo.png are packed into the nupkg, so a pull request
  // that touches only them must still build and pack; the defaults would skip
  // root markdown and assets/**. test/, benchmarks/, and samples/ are build
  // roots outside the classifier defaults (source, tests, tools, msbuild):
  // dev workflow builds and verifies them, markdown included. Task 160.
  "pullRequestBuild": {
    "buildPaths": [
      "readme.md",
      "assets/logo.png",
      "test/**",
      "benchmarks/**",
      "samples/**"
    ]
  }
}
