<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Same pair as the library so the suite runs on net10.0 and net11.0.
         An empty TargetFramework clears the root pin (both set is NETSDK1013). -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup Label="Testing Packages">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="TimeWarp.Fixie" />
    <PackageReference Include="Fixie.TestAdapter" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\..\source\timewarp-flexbox\timewarp-flexbox.csproj" />
  </ItemGroup>

</Project>
