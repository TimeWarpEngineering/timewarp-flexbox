<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Suppress warnings that don't apply to CLI tools (same set as sibling repos'
         dev-cli). IDE0005/0052/0055/0058/0160/0290: style rules violated by
         TimeWarp.Nuru.DevCli content files compiled from the NuGet cache, where the
         repo .editorconfig cannot reach. IDE0211: dev.cs is a runfile and requires
         top-level statements. -->
    <NoWarn>$(NoWarn);CA1031;CA1303;CA1508;CA1515;CA1849;CA2007;CA2016;CA2000;CA1034;CA5399;IDE0065;IL2026;IL2104;IL3050;IL3053;RCS1046;RCS1194;IDE0005;IDE0052;IDE0055;IDE0058;IDE0160;IDE0211;IDE0290</NoWarn>

    <!-- AOT Support -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- No XML doc file: the dev runfile AOT publish (self-install) fails MSB3030
         looking for a documentation xml the publish layout does not copy. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Enable interceptors for TimeWarp.Nuru source generator -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);TimeWarp.Nuru.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include command files in compilation -->
    <Compile Include="global-usings.cs" />
    <Compile Include="endpoints/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Package references -->
    <PackageReference Include="TimeWarp.Nuru" />
    <PackageReference Include="TimeWarp.Nuru.DevCli" />
    <PackageReference Include="TimeWarp.Amuru" />
    <!-- Amuru 1.0.0-beta.35 split RepoClean / Git.* / DotNet.* into Tools (same TimeWarp.Amuru namespace). -->
    <PackageReference Include="TimeWarp.Amuru.Tools" />
    <PackageReference Include="TimeWarp.Terminal" />
  </ItemGroup>

  <!-- TimeWarp.Nuru.DevCli 4.0.0-beta.12 compiles release-command.cs (609 lines) and
       nuget-version-service.cs (704 lines) from the NuGet cache. An unsectioned
       .globalconfig would raise TWA0038.max_lines for every file in this compilation,
       including the in-repo sources, which stay on the 500-line default. Sections are
       absolute forward-slash paths because AnalyzerConfig treats '\' as an escape.
       timewarp-nuru task 577 tracks the split. -->
  <Target Name="WriteNuruDevCliLineCapGlobalConfig" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_NuruLongFile Include="@(Compile)" Condition="$([System.String]::Copy('%(Identity)').EndsWith('release-command.cs'))">
        <MaxLines>609</MaxLines>
      </_NuruLongFile>
      <_NuruLongFile Include="@(Compile)" Condition="$([System.String]::Copy('%(Identity)').EndsWith('nuget-version-service.cs'))">
        <MaxLines>704</MaxLines>
      </_NuruLongFile>
      <_NuruLongFile>
        <Normalized>$([System.String]::Copy('%(FullPath)').Replace('\','/'))</Normalized>
      </_NuruLongFile>
    </ItemGroup>
    <PropertyGroup>
      <_NuruLineCapConfig>$(IntermediateOutputPath)nuru-devcli-linecap.generated.globalconfig</_NuruLineCapConfig>
      <_NL>$([System.Environment]::NewLine)</_NL>
    </PropertyGroup>
    <ItemGroup Condition="'@(_NuruLongFile)' != ''">
      <_NuruLineCapLine Include="is_global = true" />
      <_NuruLineCapLine Include="# Package-owned TimeWarp.Nuru.DevCli sources. TWA0038's 500-line split does not apply." />
      <_NuruLineCapLine Include="# timewarp-nuru task 577 tracks the split. In-repo files keep the 500-line default." />
      <_NuruLineCapLine Include="@(_NuruLongFile->'[%(Normalized)]$(_NL)dotnet_diagnostic.TWA0038.max_lines = %(MaxLines)')" />
    </ItemGroup>
    <WriteLinesToFile
      Condition="'@(_NuruLongFile)' != ''"
      File="$(_NuruLineCapConfig)"
      Lines="@(_NuruLineCapLine)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <!-- CoreCompile reads EditorConfigFiles. GlobalAnalyzerConfigFiles is copied
         at evaluation, before this file exists. FileWrites registers it for Clean. -->
    <ItemGroup Condition="'@(_NuruLongFile)' != ''">
      <EditorConfigFiles Include="$(_NuruLineCapConfig)" />
      <FileWrites Include="$(_NuruLineCapConfig)" />
    </ItemGroup>
  </Target>

</Project>