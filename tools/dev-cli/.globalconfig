is_global = true

# TimeWarp.Nuru.DevCli 4.0.0-beta.12 compiles release-command.cs (609 lines) and
# nuget-version-service.cs (704 lines) from the NuGet cache. This repo does not own
# those files, and TWA0038's 500-line split does not apply to them. timewarp-nuru
# task 577 tracks the split. Scoped to this compilation: only projects that compile
# a file under tools/dev-cli discover this config. In-repo files stay on 500,
# with the line-cap baseline for Yoga ports.
dotnet_diagnostic.TWA0038.max_lines = 704
